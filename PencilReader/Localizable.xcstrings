    "Mostra insieme le evidenziazioni staccate che l'IA ha riconosciuto come lo stesso concetto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows together the separate highlights that the AI recognized as the same concept"
          }
        }
      }
