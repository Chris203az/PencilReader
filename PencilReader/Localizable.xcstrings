    "%@ Copia libri, note, segni, parole, statistiche e impostazioni (non le chiavi IA) in una cartella di File: scegline una in iCloud Drive per averla anche fuori dall'iPad. Restano gli ultimi %lld backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Copies books, notes, marks, words, statistics and settings (not the AI keys) to a folder in Files: pick one in iCloud Drive to have it outside the iPad too. The last %lld backups are kept."
          }
        }
      }
    },
