    },
    "Legenda": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legend"
          }
        }
      }
    },
    "Legge il testo di tutte le pagine in sottofondo, così ricerca e traduzione sono subito pronte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the text of all pages in the background, so search and translation are ready right away"
          }
        }
      }
