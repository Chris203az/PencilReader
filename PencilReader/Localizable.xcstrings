    "Leggi prima, segna dopo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read first, mark later"
          }
        }
      }
    },
    "Leggi tutto il paragrafo senza la penna. Solo alla fine decidi cosa conta: così scegli, invece di colorare tutto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the whole paragraph without the pen. Only at the end decide what matters: that way you choose, instead of coloring everything."
          }
        }
      }
    },
