          }
        }
      }
    },
    "Tempo di lettura finito": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading time over"
          }
        }
      }
    },
    "Tenendo premuto un pulsante della barra del libro, compare cosa fa invece di eseguirlo.": {
