          }
        }
      }
    },
    "Traduzione": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation"
          }
        }
      }
    },
    "Traduzione non disponibile: %@": {
      "localizations": {
        "en": {
