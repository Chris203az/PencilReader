          }
        }
      }
    },
    "Trascina la barretta tra pagina e quaderno per dare più spazio all'uno o all'altro.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the bar between page and notebook to give more room to one or the other."
          }
        }
      }
    },
    "Trascina per cambiare l'ordine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to change the order."
          }
        }
      }
    },
    "Tratto intero": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole stroke"
          }
        }
      }
    },
    "Tre evidenziatori con un significato fisso (concetto chiave, formula o dato, da rivedere), il sottolineato per i termini da imparare, la penna per le note a margine e la gomma.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three highlighters with a fixed meaning (key concept, formula or data, to review), the underline for terms to learn, the pen for margin notes and the eraser."
          }
        }
      }
    },
    "Tutte le %lld pagine del libro.": {
      "localizations": {
